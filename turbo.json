{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "check-types": { "dependsOn": ["^check-types"] },
    "test": { "dependsOn": ["^check-types"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
