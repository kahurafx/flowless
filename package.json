{
  "name": "flowless",
  "private": true,
  "scripts": {
    "bootstrap": "[ -f .env ] || cp .env.example .env; docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @flowless/db db:generate",
    "db:migrate": "pnpm --filter @flowless/db db:migrate",
    "db:seed": "pnpm --filter @flowless/seed db:seed"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "testcontainers": "^12.2.1",
    "turbo": "^2.11.10",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.17.1"
}
