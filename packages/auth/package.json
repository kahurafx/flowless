    "typescript": "^5",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@flowless/db": "workspace:*",
    "@flowless/shared-types": "workspace:*",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.0"
  }
