# Copied to .env by `pnpm bootstrap`. Values match docker-compose.yml.

# Runtime connection. Must be a role that is a member of flowless_app and does NOT own
# tables or have BYPASSRLS, so row-level security always applies (K-01, NF-01).
DATABASE_URL=postgres://flowless_api:flowless_api@localhost:54320/flowless

# Better Auth connection (packages/auth). Member of flowless_auth: reaches only the `auth`
# schema, never module schemas.
DATABASE_AUTH_URL=postgres://flowless_auth_api:flowless_auth_api@localhost:54320/flowless

# Owner connection, used only for migrations and role bootstrap.
DATABASE_ADMIN_URL=postgres://flowless:flowless@localhost:54320/flowless

REDIS_URL=redis://localhost:63790
